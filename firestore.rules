rules_version = '2';

// Regras iniciais para desenvolvimento autenticado.
// Restringir por papéis quando o cliente definir perfis.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /clients/{id} {
      allow read, write: if isSignedIn();
    }

    match /sellers/{id} {
      allow read, write: if isSignedIn();
    }

    match /sales/{id} {
      allow read, write: if isSignedIn();
    }

    match /expenses/{id} {
      allow read, write: if isSignedIn();
    }

    match /accountsPayable/{id} {
      allow read, write: if isSignedIn();
    }

    match /accountsReceivable/{id} {
      allow read, write: if isSignedIn();
    }

    match /cashMovements/{id} {
      allow read, write: if isSignedIn();
    }

    match /inventoryItems/{id} {
      allow read, write: if isSignedIn();
    }

    match /fiscalDocuments/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
