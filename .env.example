# Focus NFe - emissao fiscal real via Functions.
# Se faltar configuracao fiscal, a emissao e bloqueada e a venda continua.
VITE_FOCUS_NFE_ENV=homologacao
VITE_FOCUS_NFE_PROXY_URL=/api/focus
VITE_FOCUS_NFE_FUNCTION_ORIGIN=http://127.0.0.1:5001/jose-7db7c/southamerica-east1
VITE_FOCUS_NFE_SERIE_NFE=
VITE_FOCUS_NFE_PROXIMO_NUMERO_NFE=
VITE_FOCUS_NFE_SERIE_NFCE=
VITE_FOCUS_NFE_PROXIMO_NUMERO_NFCE=
VITE_FOCUS_NFE_CSC_NFCE=
VITE_FOCUS_NFE_ID_CSC_NFCE=

# Dados do emitente no frontend sao apenas exibicao/compatibilidade.
# A emissao real valida os dados EMITENTE_* configurados nas Functions.
VITE_EMITENTE_CNPJ=
VITE_EMITENTE_NOME=
VITE_EMITENTE_NOME_FANTASIA=
VITE_EMITENTE_LOGRADOURO=
VITE_EMITENTE_NUMERO=
VITE_EMITENTE_BAIRRO=
VITE_EMITENTE_MUNICIPIO=
VITE_EMITENTE_UF=
VITE_EMITENTE_CEP=
VITE_EMITENTE_IE=
VITE_EMITENTE_REGIME=

# Functions/servidor (nao usar prefixo VITE_ para segredos)
# FOCUS_NFE_TOKEN deve ser configurado como secret da Function.
FOCUS_NFE_ENV=homologacao
FOCUS_NFE_SERIE_NFE=
FOCUS_NFE_PROXIMO_NUMERO_NFE=
FOCUS_NFE_SERIE_NFCE=
FOCUS_NFE_PROXIMO_NUMERO_NFCE=
