VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Focus NFe - use mode=mock ate ter token/certificado reais
VITE_FOCUS_NFE_MODE=mock
VITE_FOCUS_NFE_ENV=homologacao
VITE_FOCUS_NFE_PROXY_URL=/api/focus/nfe

# Dados do emitente no frontend sao usados apenas pelo mock/legado.
# Em producao, configure EMITENTE_* nas Functions, nao como VITE_*.
VITE_EMITENTE_CNPJ=00000000000000
VITE_EMITENTE_NOME=EMPRESA EMITENTE TEMPLATE LTDA
VITE_EMITENTE_NOME_FANTASIA=Jose Gestao
VITE_EMITENTE_LOGRADOURO=Rua Exemplo
VITE_EMITENTE_NUMERO=100
VITE_EMITENTE_BAIRRO=Centro
VITE_EMITENTE_MUNICIPIO=Sao Paulo
VITE_EMITENTE_UF=SP
VITE_EMITENTE_CEP=01001000
VITE_EMITENTE_IE=ISENTO
VITE_EMITENTE_REGIME=1

# Seed (opcional)
SEED_EMAIL=admin@jose.com
SEED_PASSWORD=borderless
